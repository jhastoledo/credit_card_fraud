# ════════════════════════════════════════════════════════════════
# .gitignore — Template para projetos de portfólio DS (deploy Streamlit)
# ════════════════════════════════════════════════════════════════

# ── ⚠️ DEPLOY: environment.yml NÃO vai pro repo ─────────────────
# O Streamlit Cloud prioriza environment.yml (conda) sobre o
# requirements.txt e quebra a instalação de dependências.
# Use environment.yml localmente; deploy usa só requirements.txt.
environment.yml

# ── Dados (nunca versionar dados brutos/sensíveis) ──────────────
data/raw/
data/interim/
data/external/
# data/processed/ — MANTER no git (app precisa dos parquets)
# Exceção: ignorar parquets brutos intermediários grandes, se houver
data/processed/*_brutas.parquet
data/processed/*_bruto.parquet

# ── Modelos ─────────────────────────────────────────────────────
# models/ — MANTER no git (app precisa dos modelos)
# *.pkl     ← NÃO ignorar — app precisa dos encoders/preprocessors
# *.joblib  ← NÃO ignorar — app precisa do pipeline_final
# Ignorar apenas modelos > 100MB (limite do GitHub) — caso a caso

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Virtual documents (Jupyter/LSP) ─────────────────────────────
.virtual_documents/

# ── Ambiente ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.conda/
venv/
.venv/

# ── IDEs ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ────────────────────────────────────────────────────────
logs/
*.log

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
